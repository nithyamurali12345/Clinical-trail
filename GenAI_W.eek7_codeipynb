        "# Imports + synthetic dataset\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras import layers\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Create simple circle dataset (2D points)\n",
        "def make_circle(n=1000, radius=1.0):\n",
        "    angles = np.random.uniform(0, 2*np.pi, n)\n",
        "    x = radius * np.cos(angles)\n",
        "    y = radius * np.sin(angles)\n",
        "    return np.stack([x, y], axis=1).astype(\"float32\")\n",
        "\n",
        "real_data = make_circle(1000)\n",
        "plt.scatter(real_data[:,0], real_data[:,1], s=10)\n",
        "plt.title(\"Real 2D Circle Data\")\n",
        "plt.axis(\"equal\")\n",
        "plt.show()\n"
      ]
